{
  "name": "@crelay/sdk",
  "version": "0.1.0",
  "description": "CRelay SDK for JavaScript/TypeScript — encrypted API relay with AES-256-GCM payload protection, replay defense, route-bound AAD, and freshness validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist dist-test",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && test -n \"$(find dist-test/test -name '*.test.js' -print -quit)\" && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "crelay",
    "api-security",
    "api-encryption",
    "aes-256-gcm",
    "replay-protection",
    "aad",
    "payload-encryption",
    "encrypted-relay",
    "zero-trust",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alsawi/crelay-open.git",
    "directory": "crelay-sdk-js"
  },
  "homepage": "https://crelay.dev",
  "bugs": {
    "url": "https://github.com/Alsawi/crelay-open/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}